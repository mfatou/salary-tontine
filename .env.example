# ---------------------------------------------------------------------------
# SalaryTontine — modèle de configuration
#
# Copier ce fichier vers .env puis renseigner chaque valeur.
#   cp .env.example .env
#
# Toutes les valeurs sont volontairement vides : ce fichier est versionné et ne
# doit contenir aucun secret, pas même un exemple. Les commentaires indiquent ce
# qu'attend chaque variable.
# ---------------------------------------------------------------------------

# --- Base de données PostgreSQL ---
# Hôte de la base. En local : localhost
DB_HOST=
# Port publié vers votre machine. Par défaut 5432 ; en changer si un autre
# PostgreSQL occupe déjà ce port.
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Sécurité JWT ---
# Clé de signature. 32 caractères minimum (256 bits) pour HS256.
# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=
# Durée de validité du jeton, en secondes. Usuel : 3600 (une heure).
JWT_EXPIRATION_SECONDS=
# Nom du cookie portant le jeton. Usuel : salarytontine_token
JWT_COOKIE_NAME=
# true uniquement derrière HTTPS, en production.
JWT_COOKIE_SECURE=

# --- Serveur ---
# Port d'écoute de l'API. Usuel : 8080
SERVER_PORT=

# --- Frontend ---
# Origine autorisée pour les appels CORS. En local : http://localhost:5173
APP_FRONTEND_URL=

# --- Compte administrateur initial ---
# Créé au démarrage uniquement si la base ne contient aucun ADMIN. Sans lui, une
# base vierge n'offrirait aucun moyen de se connecter : l'inscription publique
# ne crée que des EMPLOYEE, et il faut déjà être ADMIN pour attribuer un rôle.
# Le mot de passe fait 12 caractères minimum, sinon l'amorçage est ignoré.
# Générer par exemple avec :
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24
APP_ADMIN_NAME=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Données de démonstration (développement uniquement) ---
# true crée sept comptes fictifs et une tontine, si la base est vide.
# À laisser à false hors développement.
APP_SEED_ENABLED=
# Mot de passe commun aux comptes de démonstration. 8 caractères minimum.
APP_SEED_PASSWORD=

# --- Traitement automatique ---
# true génère chaque jour les cotisations et les salaires des tours échus.
APP_SCHEDULING_ENABLED=
# Expression cron Spring (secondes minutes heures jour mois jour-semaine), UTC.
# Usuel : 0 0 2 * * *
APP_MONTHLY_RUN_CRON=

# --- Frontend (build Vite) ---
# URL publique de l'API, figée au moment du build du frontend.
# En local : http://localhost:8080
VITE_API_BASE_URL=
