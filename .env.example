# SalaryTontine — modèle de configuration.
#   cp .env.example .env      puis renseigner chaque valeur.
# Fichier versionné : il ne doit contenir aucun secret, pas même un exemple.

# --- Base de données PostgreSQL ---
# Hôte : localhost en local. Port : 5432, à changer si déjà occupé.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Sécurité JWT ---
# Clé de signature, 32 caractères minimum (HS256).
#   openssl rand -base64 48
JWT_SECRET=
# Durée de validité en secondes. Usuel : 3600
JWT_EXPIRATION_SECONDS=
# Nom du cookie. Usuel : salarytontine_token
JWT_COOKIE_NAME=
# true par défaut. false uniquement pour un accès local en HTTP.
JWT_COOKIE_SECURE=

# --- Limitation des tentatives d'authentification ---
# Plafonne /api/auth/login et /api/auth/register par adresse d'origine.
# Usuel : true, 10 tentatives, fenêtre de 60 secondes.
APP_RATE_LIMIT_ENABLED=
APP_RATE_LIMIT_MAX_ATTEMPTS=
APP_RATE_LIMIT_WINDOW_SECONDS=

# --- Serveur et frontend ---
# Port d'écoute de l'API : 8080. Origine CORS : http://localhost:5173
SERVER_PORT=
APP_FRONTEND_URL=

# --- Compte administrateur initial ---
# Créé au démarrage si la base ne contient aucun ADMIN. Sans lui, une base
# vierge serait inaccessible. Mot de passe : 12 caractères minimum.
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24
APP_ADMIN_NAME=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Données de démonstration (développement uniquement) ---
# true crée sept comptes fictifs et une tontine, si la base est vide.
# Mot de passe commun : 8 caractères minimum.
APP_SEED_ENABLED=
APP_SEED_PASSWORD=

# --- Traitement automatique ---
# true génère chaque jour les cotisations et salaires des tours échus.
# Cron Spring (s min h jour mois jour-semaine), UTC. Usuel : 0 0 2 * * *
APP_SCHEDULING_ENABLED=
APP_MONTHLY_RUN_CRON=

# --- Frontend (build Vite) ---
# URL publique de l'API, figée au build. En local : http://localhost:8080
VITE_API_BASE_URL=
