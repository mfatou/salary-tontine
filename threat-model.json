            "data": {
              "type": "tm.Flow",
              "name": "Requêtes HTTP/JSON + cookie JWT transmis par le navigateur",
              "description": "Le navigateur transmet les requêtes issues de la SPA ainsi que le cookie JWT HttpOnly. Les données incluent credentials, identifiants de ressources, paramètres et données métier.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "protocol": "HTTP/JSON",
              "isEncrypted": false,
              "isPublicNetwork": true,
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Usurpation d'identité par vol ou rejeu du JWT",
                  "type": "Spoofing",
                  "description": "Un attaquant qui obtient le cookie JWT d'un utilisateur pourrait rejouer le jeton et agir en son nom jusqu'à son expiration. Le risque est particulièrement important pour un compte ACCOUNTANT ou ADMIN.",
                  "mitigation": "Conserver le JWT en cookie HttpOnly, imposer HTTPS et Secure=true en production, maintenir une durée de vie courte, protéger et faire tourner JWT_SECRET, et prévoir un mécanisme de révocation/rotation pour les cas sensibles.",
                  "modelType": "STRIDE",
                  "id": "bc6bebbe-62ff-4156-bae7-e9672db8d4c2"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Altération des données métier envoyées par le client",
                  "type": "Tampering",
                  "description": "Un client peut modifier les identifiants, montants, paramètres ou ordres envoyés dans les requêtes HTTP afin de tenter d'altérer une tontine, une adhésion, une cotisation ou un calcul salarial.",
                  "mitigation": "Valider toutes les entrées côté serveur, dériver l'identité depuis le JWT vérifié, ne jamais utiliser un calcul salarial fourni par le client, appliquer les règles métier dans les services et conserver les contraintes d'intégrité en base.",
                  "modelType": "STRIDE",
                  "id": "6b93a57d-a7bb-4151-b0a0-f10b5a5c85db"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Interception de données sensibles sur le flux client-serveur",
                  "type": "Information disclosure",
                  "description": "Si l'application est déployée sans TLS, les identifiants, réponses métier et cookie d'authentification peuvent être interceptés en transit.",
                  "mitigation": "Imposer HTTPS/TLS en production, activer Secure=true sur le cookie JWT, ajouter HSTS et refuser les accès HTTP non chiffrés.",
                  "modelType": "STRIDE",
                  "id": "dc5b8418-620f-4c09-8536-8ef340754203"
                }
              ],
              "isTrustBoundary": false
            },
