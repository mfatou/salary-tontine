            },
            "attrs": {
              "text": {
                "text": "Spring Boot REST API\n+ Spring Security / JWT"
              },
              "body": {
                "stroke": "red",
                "strokeWidth": 3,
                "strokeDasharray": null
              }
            },
            "shape": "process",
            "zIndex": 4,
            "id": "fb8b7f65-cb6e-420a-804e-c506ec240041",
            "data": {
              "name": "Spring Boot REST API\n+ Spring Security / JWT",
              "description": "API REST Java/Spring Boot. Authentification JWT par cookie, contrôle du statut du compte, autorisations Spring Security et @PreAuthorize.",
              "type": "tm.Process",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Élévation de privilèges EMPLOYEE vers ACCOUNTANT ou ADMIN",
                  "type": "Elevation of privilege",
                  "description": "Un utilisateur pourrait tenter d'accéder à une fonction privilégiée en manipulant son rôle côté client, un identifiant de ressource ou un jeton.",
                  "mitigation": "Vérifier la signature JWT, contrôler le statut ACTIVE en base, appliquer @PreAuthorize et les contrôles d'autorisation côté backend, et ne jamais considérer les gardes React comme un contrôle de sécurité.",
                  "modelType": "STRIDE",
                  "id": "64ffb077-9ba2-4ec4-b4dc-d98899627f5d"
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "title": "Saturation des endpoints d'authentification",
                  "type": "Denial of service",
                  "description": "Des requêtes répétées sur /api/auth/login ou /api/auth/register peuvent consommer des ressources et empêcher les utilisateurs légitimes d'accéder au service.",
                  "mitigation": "Ajouter un rate limiting sur les endpoints publics sensibles, limiter les tentatives, journaliser les abus et prévoir des seuils de protection adaptés.",
                  "modelType": "STRIDE",
                  "id": "5b6f9112-4e7d-4d09-8193-d49b75ac2ee7"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Divulgation de salaires ou de données d'un autre utilisateur",
                  "type": "Information disclosure",
                  "description": "Une erreur de contrôle d'accès au niveau d'un endpoint ou d'un objet pourrait exposer le salaire de base, l'historique salarial, les cotisations ou les données de tontine d'un autre utilisateur.",
                  "mitigation": "Appliquer RBAC et autorisation au niveau objet côté serveur, filtrer les ressources selon l'utilisateur courant, utiliser des DTO minimaux, et tester systématiquement les accès croisés entre EMPLOYEE, ACCOUNTANT et ADMIN.",
                  "modelType": "STRIDE",
                  "id": "ea0616b2-8468-4a1c-9d00-f1edcba0325f"
                }
              ],
              "hasOpenThreats": true,
              "isWebApplication": true
            }
