              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Altération directe des salaires, cotisations ou journaux en base",
                  "type": "Tampering",
                  "description": "Un accès non autorisé à PostgreSQL pourrait permettre de modifier des salary_records, contributions, rôles, turn_order ou audit_logs en contournant les règles métier du backend.",
                  "mitigation": "Restreindre PostgreSQL au réseau interne en production, appliquer le moindre privilège au compte BDD, ne pas publier inutilement le port BDD, conserver les contraintes SQL et mettre en place sauvegardes et contrôles d'intégrité.",
                  "modelType": "STRIDE",
